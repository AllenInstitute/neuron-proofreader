#!/usr/bin/env bash

set -e

setup_google_creds() {
    # Create a temporary file
    TEMP_CRED_FILE=$(mktemp --suffix=".json")
    
    # Ensure temporary file is removed on script exit or interrupt
    trap "rm -f $TEMP_CRED_FILE" EXIT
    
    # Write the environment variable content to the temporary file
    echo "${CUSTOM_KEY}" > "$TEMP_CRED_FILE"

    export GOOGLE_APPLICATION_CREDENTIALS=$TEMP_CRED_FILE

}

setup_google_creds

export AWS_REGION=us-west-2

# Parse all named parameters into an associative array
declare -A PARAMS

while [[ $# -gt 0 ]]; do
    if [[ "$1" == --*=* ]]; then
        key="${1%%=*}"; key="${key#--}"
        PARAMS["$key"]="${1#*=}"
        shift
    elif [[ "$1" == --* ]]; then
        key="${1#--}"
        PARAMS["$key"]="${2:-}"
        shift 2
    else
        shift
    fi
done

MODE="${PARAMS[mode]:-train}"

# Dispatch, forwarding only the params each script expects
case "$MODE" in
    train)
        TRAIN_KEYS=(base_channels block_type depth model_name max_channels lr min_recall random_nonmerge_site_prob)
        TRAIN_ARGS=()
        for k in "${TRAIN_KEYS[@]}"; do
            [[ -v PARAMS["$k"] ]] && TRAIN_ARGS+=("--${k}=${PARAMS[$k]}")
        done
        python -u train.py "${TRAIN_ARGS[@]}"
        ;;
    evaluate)
        EVAL_KEYS=(brain_id segmentation_id version top_k_ckpts min_search_size step_size threshold)
        EVAL_ARGS=()
        for k in "${EVAL_KEYS[@]}"; do
            [[ -v PARAMS["$k"] ]] && EVAL_ARGS+=("--${k}=${PARAMS[$k]}")
        done
        python -u evaluate.py "${EVAL_ARGS[@]}"
        ;;
    *)
        echo "Invalid mode: '$MODE'. Must be 'train' or 'evaluate'." >&2
        exit 1
        ;;
esac
